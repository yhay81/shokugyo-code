{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shokugyo-code",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "shokugyo-code.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["27 21 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shokugyo-code",
      "database_id": "5853176e-d5f4-43c8-b7da-cd43cb4886b4",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
